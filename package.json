{
  "name": "dsh-recall",
  "version": "2.0.0",
  "description": "dsh 撤回：只撤最后一条用户消息，对话与工作区文件一起回退（文字与附件一起回填输入框）",
  "type": "module",
  "main": "lib/index.js",
  "author": "佐罗斯 (Zok66)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zok66/dsh-recall"
  },
  "homepage": "https://github.com/Zok66/dsh-recall#readme",
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "license": "MIT"
}
